# ============================================================================
#  Minecraft: Story Mode — PS Vita loader (soloader). SOURCE ONLY.
#  This repo ships the LOADER. It contains NO game content. Running it
#  requires the user's own legally-owned copy of the Android game
#  (APK + OBB), which is extracted locally into prepared_data/ and never
#  committed. Everything below is build output, editor cruft, or
#  copyrighted game material that MUST NOT be published.
# ============================================================================

# --- Build artifacts / output ---
# Glob, not a fixed list: ad-hoc build dirs (build_notrophy/, build_rel_nolog/,
# build_v_logging/, ...) get created constantly while A/B-ing configurations, and an
# exact-match list silently fails to cover the next one -- which then shows up as
# untracked and rides along with a `git add -A`.
build*/
cmake-build-*/
vpk/
logs/
*.velf
*.self
*.vpk
eboot.bin
eboot.bin.out

# --- COPYRIGHTED GAME CONTENT — NEVER COMMIT ------------------------------
#     (Telltale / Mojang. Requires the user's own game copy.)
prepared_data/
apk/
apk_assets/
*.apk
*.obb
# game native libs extracted from the APK
libGameEngine.so
libfmod*.so
libmain.so
libSDL2.so
# reference art copied from the Android build
*_android.png
# LiveArea art + trophy pack built from the retail game's own images. The repo
# keeps PLACEHOLDER livearea PNGs (committed, so a fresh clone still builds a
# working VPK); a local build may overwrite them with the real thing, and that
# must never be pushed. Same for TROPHY.TRP, whose icons are game art.
extras/livearea_placeholder_bak/
extras/trophy/
# proprietary PowerVR driver (Imagination Technologies — "Strictly Confidential",
# NOT redistributable). The shipping build is vitaGL; these are never used or published.
lib/pvr/
third_party/pvr_psp2/
# dead PVR-only loader sources (our own code, but vitaGL is the only backend now)
source/utils/pvr_init.*
source/reimpl/pvr_gles_stubs.c
source/reimpl/egl_pvr_shim.*
source/psp2_pvr_hint.h

# --- Runtime captures / accumulated caches (device state, not source) ---
extras/_progcache_accum/
extras/choice_stats/
extras/progcache_seed.bin*
*.STALE*

# --- Backups / editor / OS ---
*.p5bak
*.prebubble_bak
*.bak
.DS_Store
.idea/
__pycache__/
lib/libc_bridge/out/

# --- Session scratch / internal notes (personal paths + LAN IPs; not published) ---
# These are working notes written during development. They routinely quote local
# build paths (C:\Users\<name>\...), so they must never be committed to a public
# repo. Keep them on disk, out of git.
scratchpad_*.md
CHANGES_*.md
MEGAPASS_*.md
PERF_FINDINGS_*.md
# tools/ was deliberately removed from the published repo (local helpers: trophy-pack
# builder, TRP reader/writer, data-prep script). The files still live on disk because
# they are needed to rebuild a trophy pack -- keep them OUT of git.
tools/
docs/AI_PORTING_GUIDE.md
CODEX_HANDOFF.md
ai_build_vpk.ps1
tools/maintenance_legacy/

# --- Data Builder local output (publish as a release artifact, not source) ---
data-builder/bin/
data-builder/obj/
data-builder/dist/
data-builder/LocalAssets/
data-builder/tests/bin/
data-builder/tests/obj/
